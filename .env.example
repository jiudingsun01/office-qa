# Copy to .env and fill in. .env is gitignored.

# Anthropic API key — used when the Hermes profile's provider is `anthropic`
# (e.g. the officeqa-iter-opus48 profile running claude-opus-4-8).
ANTHROPIC_API_KEY=sk-ant-...

# Stanford Azure Foundry gateway key — used by gpt-5.x profiles
# (officeqa-iter-v2). Optional if you only run the Anthropic profile.
AZURE_FOUNDRY_API_KEY=sk-...
