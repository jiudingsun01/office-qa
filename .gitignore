# ---- secrets ----
.env
*.env
!.env.example

# ---- python / venv / cache ----
.venv/
__pycache__/
*.pyc
.cache/
.pytest_cache/

# ---- large / gated dataset (download via HF; see data/README.md) ----
# OfficeQA corpus: PDFs (~1.6G), parsed JSON/txt (~367M), augmented MD (~372M),
# and the answer CSVs are gated (CC-BY-SA, answer-key clause). Do not commit.
data/
final_parsed_db_augmented.tar.gz

# ---- scratch ----
tmp/
tmp_maxima/
ols_1968.py
reg_my2.py
*.png

# ---- oracle baseline runs (pre-existing, ~3.2G) ----
baselines/runs/

# ---- Hermes meta-opt run artifacts ----
# Included: aggregate summaries (summary.json, history.json, *.log, manifest.json)
# AND the per-question trajectories + results:
#   preds/<uid>.json     (final answer, rationale, gold, score)
#   logs/<uid>.log       (rc / elapsed / captured stdout-stderr)
#   reflections/<uid>.json (train-phase reflection outputs)
#   per_row.jsonl        (uid, gold, predicted, score)
# NOTE: these embed the gated OfficeQA gold answers — see EXPERIMENTS.md §9.
# Excluded: the redundant ~19 MB-per-iter skill-library copies, and plots.
baselines/hermes_iter/runs/**/snapshot/

# Raw session-trace tarballs (verbatim sessions incl. base64 page images, large).
# The readable per-uid traces under runs/**/traces/*.md ARE committed.
baselines/hermes_iter/runs/**/traces_raw.tar.gz

# Generated split prompts embed gold answers (gated) + absolute paths.
# Regenerate deterministically with build_splits.py (seed 42). Manifests are kept.
baselines/hermes_iter/splits/*.jsonl
baselines/hermes_iter/splits_parsed_md/*.jsonl
baselines/hermes_iter/splits_parsed_md_plus_pdf/*.jsonl
